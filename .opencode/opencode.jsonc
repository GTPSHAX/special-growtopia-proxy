{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mandor",
  "subagent_depth": 1,
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    }
  },
  "mcp": {
    "agent-toolkit": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@gtpshax/agent-toolkit@latest",
        "mcp"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "oauth": false,
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      },
      "enabled": true
    }
  }
}
